# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python bytecode and tooling
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and local configuration
.venv/
venv/
env/
.env
.env.*
!.env.example

# Build and package outputs
build/
dist/
*.egg-info/

# IDEs and notebooks
.idea/
.vscode/
.ipynb_checkpoints/

# Local caches and temporary files
.cache/
.tmp/
.torch_cache/
.huggingface/
tmp/
temp/

# Competition data. Keep only the directory documentation in Git.
/data/*
!/data/README.md
/datasets/
*.parquet
*.feather
*.arrow

# Generated artifacts. Keep only the directory documentation in Git.
/artifacts/*
!/artifacts/README.md
/submissions/
outputs/
runs/
wandb/
mlruns/
checkpoints/

# Large model files. Keep only the inventory in Git.
models/*
!models/README.md
solutions/*/models/
*.ckpt
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.msgpack
*.joblib
!solutions/cross_encoder_baseline/baseline_logreg_l12.joblib
*.cbm

# Local archives
*.zip
*.tar
*.tar.gz
*.tgz

# данные разметки — исключение из глобального *.parquet
!labeling/*.parquet
# исполненные ноутбуки с выводами — исключение из runs/
!notebooks/runs/
!notebooks/runs/**
!data_polygon/*.parquet
!scores/**
